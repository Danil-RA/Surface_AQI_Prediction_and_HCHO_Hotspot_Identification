# Optional — override these in .env (never commit .env)

# Allow additional origins (comma-separated) beyond the default localhost:5173
EXTRA_CORS_ORIGINS=

# Override the default fixture paths with real prediction store paths
PREDICTIONS_PARQUET=api/fixtures/predictions.parquet
STATIONS_PARQUET=api/fixtures/stations.parquet
VALIDATION_PARQUET=api/fixtures/validation.parquet
HOTSPOTS_GEOJSON=api/fixtures/hotspots.geojson
